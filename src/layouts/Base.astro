---

import '../styles/site.css';
import footer from '../content-html/_footer.html?raw';

const { title, description, path, overlayNav = false } = Astro.props;
const nav = [
  ['Home', '/'],
  ['About', '/about.html'],
  ['Work With Me', '/work-with-me.html'],
  ['Contact', '/contact.html'],
  ['Blog', '/blog.html'],
];
const isPreview = !!process.env.SITE_BASE;
const canonical = path ? new URL(path, Astro.site).href : undefined;
const shareImage = new URL('/img/og-card.jpg', Astro.site).href;

// Tells search engines who the site is about. Only the home page carries it.
const book = 'https://www.amazon.com/dp/B0GPLSZJPX';
const structuredData = path === '/' && {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://www.cliffkinchen.com/#website',
      url: 'https://www.cliffkinchen.com/',
      name: 'Cliff Kinchen | The Kinchen Standard',
      publisher: { '@id': 'https://www.cliffkinchen.com/#cliff' },
    },
    {
      '@type': 'Person',
      '@id': 'https://www.cliffkinchen.com/#cliff',
      name: 'Cliff Kinchen',
      alternateName: 'Kyoshi Cliff Kinchen',
      url: 'https://www.cliffkinchen.com/',
      image: new URL('/img/headshot.jpg', Astro.site).href,
      jobTitle: 'Leadership Educator, Speaker, Author',
      email: 'mailto:info@cliffkinchen.com',
      sameAs: ['https://www.linkedin.com/in/cliff-kinchen-mba-a2715838', 'https://x.com/KyoshiKinchen', book],
    },
    {
      '@type': 'Book',
      name: 'Resilient Warrior: Be the Standard',
      author: { '@id': 'https://www.cliffkinchen.com/#cliff' },
      url: book,
      image: new URL('/img/resilient-warrior-cover.png', Astro.site).href,
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/img/logo-ck.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cliff Kinchen | The Kinchen Standard" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cliff Kinchen, Leadership Educator, Speaker, Author" />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {isPreview && <meta name="robots" content="noindex" />}
    <script is:inline>
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reveal');
    </script>
  </head>
  <body class:list={{ 'light-nav': !overlayNav }}>
    <header class="site-nav">
      <a class="logo" href="/"><img src="/img/logo-ck.png" alt="Cliff Kinchen | The Kinchen Standard" width="50" height="50" /></a>
      <button class="hamburger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="menu"><span></span></button>
      <nav id="menu">
        <ul>
          {nav.map(([label, href]) => <li><a href={href} aria-current={href === path ? 'page' : undefined}>{label}</a></li>)}
        </ul>
      </nav>
    </header>
    <main class:list={{ 'under-nav': !overlayNav }}><slot /></main>
    <footer class="site-footer" set:html={footer} />
    <script>
      const button = document.querySelector('.hamburger');
      button.addEventListener('click', () => {
        const open = document.body.classList.toggle('menu-open');
        button.setAttribute('aria-expanded', String(open));
      });

      const onScroll = () => document.body.classList.toggle('scrolled', scrollY > 50);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      if (document.documentElement.classList.contains('reveal')) {
        const observer = new IntersectionObserver((entries) => {
          entries.filter((e) => e.isIntersecting).forEach((e, i) => {
            e.target.style.transitionDelay = `${200 + i * 100}ms`;
            e.target.classList.add('shown');
            observer.unobserve(e.target);
          });
        });
        document.querySelectorAll('main > section').forEach((s) => observer.observe(s));
      }
    </script>
  </body>
</html>
